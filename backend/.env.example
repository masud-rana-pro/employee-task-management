# Copy this file to ".env" for local runs (never commit the real .env) and set the same
# variables in your hosting dashboard for production.

# JDBC URL of MySQL. Local:
DB_URL=jdbc:mysql://localhost:3306/taskdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Cloud MySQL (Aiven etc.) needs SSL, for example:
# DB_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-of-32-chars-or-more
# Token lifetime in milliseconds (3600000 = 1 hour)
JWT_EXPIRATION_MS=3600000

# Origin(s) of the Angular app, comma separated, no trailing slash
CORS_ALLOWED_ORIGINS=http://localhost:4200
